[Unit]
Description=Consulta de cliente (Bitrix24)
After=network.target
[Service]
User=consulta
WorkingDirectory=/opt/consulta-cliente
EnvironmentFile=/etc/consulta-cliente.env
ExecStart=/usr/bin/node server.js
Restart=always
StateDirectory=consulta-cliente
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
